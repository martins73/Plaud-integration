# Copy to .env and fill in. The .env file is gitignored.

# --- PLAUD cloud token (required for the cloud source) ---
# How to get it:
#   1. Sign in at https://web.plaud.ai
#   2. Open DevTools -> Application -> Local Storage -> https://web.plaud.ai
#   3. Copy the value of the "tokenstr" key. It looks like:  bearer eyJ...
#      (a long JWT, valid ~10 months)
#   You can paste it with or without the leading "bearer ".
# Or run:  plaud-brain auth  and paste it interactively.
PLAUD_TOKEN=

# --- Gemini API key (required for transcription + summarization) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
